# Copy to .env and fill in. .env is git-ignored; never commit credentials.
# For the scheduled GitHub Actions job these are repository secrets instead.

# D-TRO consumer application credentials (create an application in the D-TRO
# user portal after your account is approved: https://dtro-ui.dft.gov.uk).
DTRO_CLIENT_ID=
DTRO_CLIENT_SECRET=

# Production by default. Integration (test data) is https://dtro-integration.dft.gov.uk/v1
DTRO_BASE_URL=https://dtro.dft.gov.uk/v1

# Area to publish, as west,south,east,north in WGS84 degrees. Default: Greater London.
# Use "all" to publish everything in the store.
# LOCIS_REGION=-0.5104,51.2868,0.3340,51.6919

# Where the pipeline keeps its SQLite working database and writes tiles.
# LOCIS_DB=pipeline/var/locis.sqlite
# LOCIS_OUT=pipeline/dist

# Read D-TRO records from a directory of JSON files instead of the live service.
# LOCIS_FIXTURES_DIR=

# Set to 1 to stop the pipeline downloading the OSTN15 coordinate grid.
# LOCIS_OFFLINE=
